{
  "name": "tablog",
  "description": "A VS Code-themed blog powered by Notion.",
  "version": "1.21.17",
  "packageManager": "yarn@1.22.22",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jung-geun/tablog.git"
  },
  "scripts": {
    "setup": "node scripts/setup-env.js",
    "dev": "nice -n 10 next dev --webpack",
    "prebuild": "rm -f public/sitemap.xml public/sitemap-*.xml",
    "build": "next build --webpack",
    "start": "next start",
    "warm:graph": "curl -fsS \"http://localhost:${PORT:-3000}/graphs/notion-graph.json\" -o /dev/null -w 'graph warmed: HTTP %{http_code} in %{time_total}s\\n'",
    "lint": "eslint \"src/**/*.{ts,tsx,js}\" \"tests/**/*.{ts,tsx,js}\" \"*.{js,mjs}\"",
    "type-check": "tsc --noEmit",
    "test": "jest --config jest.config.unit.js",
    "test:unit": "jest --config jest.config.unit.js",
    "test:integration": "jest --config jest.config.integration.js",
    "test:all": "yarn test:unit && yarn test:integration",
    "test:watch": "jest --config jest.config.unit.js --watch",
    "test:coverage": "jest --config jest.config.unit.js --coverage",
    "test:coverage:all": "yarn test:coverage && yarn test:integration --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.55.1",
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@notionhq/client": "^5.21.0",
    "@qdrant/js-client-rest": "^1.18.0",
    "@radix-ui/colors": "^2.1.0",
    "@tanstack/react-query": "^5.100.10",
    "@types/katex": "^0.16.7",
    "@visx/group": "4.0.0",
    "@visx/heatmap": "4.0.0",
    "@visx/responsive": "4.0.0",
    "@visx/scale": "4.0.0",
    "caniuse-lite": "^1.0.30001792",
    "clsx": "2.1.1",
    "cookies-next": "^5.1.0",
    "d3-drag": "^3.0.0",
    "d3-force": "^3.0.0",
    "d3-force-3d": "^3.0.6",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "dotenv": "^17.2.3",
    "ioredis": "^5.4.0",
    "katex": "^0.16.25",
    "lru-cache": "^11.3.6",
    "mermaid": "^11.16.1",
    "motion": "12.27.0",
    "next": "^16.4.1",
    "notion-types": "^7.10.0",
    "notion-utils": "^7.10.0",
    "prismjs": "^1.30.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-icons": "^5.6.0",
    "react-notion-x": "^7.10.0",
    "tailwind-merge": "3.7.0",
    "three": "^0.186.1",
    "zod": "^4.4.3"
  },
  "resolutions": {
    "@babel/core": "^7.29.7",
    "eslint/**/js-yaml": "^4.3.2",
    "jest/**/js-yaml": "^3.15.2",
    "@jest/**/js-yaml": "^3.15.2",
    "postcss": "^8.5.23",
    "source-map-js": "^1.2.2",
    "uuid": "^14.0.0",
    "ws": "^8.21.3",
    "next/**/sharp": "^0.35.4",
    "@qdrant/js-client-rest/**/undici": "^6.28.1",
    "mermaid/**/dompurify": "^3.4.16",
    "eslint/**/brace-expansion": "^1.1.21",
    "**/test-exclude/**/brace-expansion": "^1.1.21",
    "**/@jest/reporters/**/brace-expansion": "^2.1.7",
    "**/jest-runtime/glob/**/brace-expansion": "^2.1.7",
    "**/@typescript-eslint/typescript-estree/**/brace-expansion": "^5.0.12"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@swc/core": "^1.15.33",
    "@swc/jest": "^0.2.39",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/d3-drag": "^3.0.7",
    "@types/d3-force": "^3.0.10",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-zoom": "^3.0.8",
    "@types/gtag.js": "^0.0.20",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.7.0",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.186.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.3",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "postcss": "^8.5.23",
    "prettier": "^3.8.3",
    "tailwindcss": "4.3.3",
    "typescript": "^6.0.3",
    "whatwg-fetch": "^3.6.20"
  }
}

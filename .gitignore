# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# Local Google OAuth credentials
/client_secret_*.json
/application_default_credentials.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

public/robots.txt
public/sitemap.xml

/.firebase
.tmp_ts_build/
logs/
tsconfig.tsbuildinfo

# Notion page cache (L2 filesystem cache)
.notion-cache/
# Image BLOB disk cache (mounted as Docker volume in production)
.image-cache/
.gstack/
/docker-compose.override.yml
/package-lock.json

# Local durable content registry (CONTENT_STATE_DIR)
/.content-state/
